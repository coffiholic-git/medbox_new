# Copy this file to ".env" (same folder) and fill in your own Firebase
# project's values to enable the "Continue with Google" button.
#
# Where to get these: https://console.firebase.google.com
#   1. Create a project (or use an existing one).
#   2. Build > Authentication > Sign-in method > enable "Google".
#   3. Project settings (gear icon) > General > "Your apps" > add a Web app.
#   4. Copy the firebaseConfig values it gives you into the six fields below.
#   5. Authentication > Settings > "Authorized domains" — add the domain(s)
#      you'll actually open the app from (localhost is allowed by default).
#
# Without this file, the app still works fully via email + password —
# only the Google button needs these.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
